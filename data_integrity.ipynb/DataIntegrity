def clasificar_discrepancia(row):
    
    diff_max = max(abs(row['settlement_amount_new'] - row['settlement_amount_legacy']), 
                   abs(row['legal_fees_new'] - row['legal_fees_legacy']))
    
    if diff_max <= 10:
        return 'Minor Difference'
    elif diff_max <= 1000:
        return 'Major Difference'
    else:
        return 'Critical Difference'

errores_financieros['severity'] = errores_financieros.apply(clasificar_discrepancia, axis=1)


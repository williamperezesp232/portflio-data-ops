import unicodedata

def normalize_text(text):
    if pd.isna(text):
        return text
    text = text.strip().lower()
    text = unicodedata.normalize('NFKD', text)
    text = ''.join(c for c in text if not unicodedata.combining(c))
    return text

df['client_name_original'] = df['client_name']
df['client_name_normalized'] = df['client_name'].apply(normalize_text)


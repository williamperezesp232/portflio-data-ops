np.random.seed(42)
random.seed(42)

n = 8000


case_ids = np.random.randint(100000, 102000, n)

client_names = np.random.choice(
    ['John Smith', 'Maria Lopez', 'Carlos Pérez', 'Anna Müller', ''],
    n,
    p=[0.3, 0.25, 0.2, 0.15, 0.1]  # some empty names
)


def random_date():
    base = pd.to_datetime('2022-01-01') + pd.to_timedelta(
        np.random.randint(0, 900), unit='D'
    )
    formats = [
        base.strftime('%Y-%m-%d'),
        base.strftime('%m/%d/%Y'),
        base.strftime('%d-%m-%Y'),
        base.strftime('%Y/%m/%d')
    ]
    return random.choice(formats)

trial_dates = [random_date() for _ in range(n)]


legal_fees = np.round(np.random.uniform(-500, 15000, n), 2)
mask_text = np.random.rand(n) < 0.05
legal_fees = legal_fees.astype(object)
legal_fees[mask_text] = 'N/A'

